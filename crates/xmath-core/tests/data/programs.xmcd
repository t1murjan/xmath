<?xml version="1.0" encoding="UTF-8"?>
<worksheet xmlns="http://schemas.mathsoft.com/worksheet30" xmlns:ml="http://schemas.mathsoft.com/math30">
<regions>
<region region-id="1" left="36" top="20" width="300" height="60"><math><ml:define><ml:function><ml:id>f</ml:id><ml:boundVars><ml:id>n</ml:id></ml:boundVars></ml:function><ml:program><ml:localDefine><ml:id>s</ml:id><ml:real>0</ml:real></ml:localDefine><ml:for><ml:id>i</ml:id><ml:range><ml:real>1</ml:real><ml:id>n</ml:id></ml:range><ml:localDefine><ml:id>s</ml:id><ml:apply><ml:plus/><ml:id>s</ml:id><ml:apply><ml:pow/><ml:id>i</ml:id><ml:real>2</ml:real></ml:apply></ml:apply></ml:localDefine></ml:for><ml:return><ml:id>s</ml:id></ml:return></ml:program></ml:define></math></region>
<region region-id="2" left="36" top="100" width="300" height="60"><math><ml:eval><ml:apply><ml:id>f</ml:id><ml:real>10</ml:real></ml:apply><ml:result><ml:real>385</ml:real></ml:result></ml:eval></math></region>
<region region-id="3" left="36" top="140" width="300" height="60"><math><ml:define><ml:function><ml:id>h</ml:id><ml:boundVars><ml:id>x</ml:id></ml:boundVars></ml:function><ml:program><ml:ifThen><ml:parens><ml:apply><ml:lessThan/><ml:id>x</ml:id><ml:real>0</ml:real></ml:apply></ml:parens><ml:str>neg</ml:str></ml:ifThen><ml:otherwise><ml:str>pos</ml:str></ml:otherwise></ml:program></ml:define></math></region>
<region region-id="4" left="36" top="180" width="300" height="60"><math><ml:eval><ml:apply><ml:id>h</ml:id><ml:real>-2</ml:real></ml:apply></ml:eval></math></region>
<region region-id="5" left="36" top="220" width="300" height="60"><math><ml:define><ml:function><ml:id>w</ml:id><ml:boundVars><ml:id>a</ml:id></ml:boundVars></ml:function><ml:program><ml:localDefine><ml:id>i</ml:id><ml:real>0</ml:real></ml:localDefine><ml:while><ml:apply><ml:lessThan/><ml:id>i</ml:id><ml:id>a</ml:id></ml:apply><ml:program><ml:localDefine><ml:id>i</ml:id><ml:apply><ml:plus/><ml:id>i</ml:id><ml:real>1</ml:real></ml:apply></ml:localDefine><ml:ifThen><ml:apply><ml:equal/><ml:id>i</ml:id><ml:real>5</ml:real></ml:apply><ml:parens><ml:break/></ml:parens></ml:ifThen></ml:program></ml:while><ml:id>i</ml:id></ml:program></ml:define></math></region>
<region region-id="6" left="36" top="260" width="300" height="60"><math><ml:eval><ml:apply><ml:id>w</ml:id><ml:real>100</ml:real></ml:apply></ml:eval></math></region>
<region region-id="7" left="36" top="300" width="300" height="60"><math><ml:define><ml:function><ml:id>k</ml:id><ml:boundVars><ml:id>x</ml:id></ml:boundVars></ml:function><ml:program><ml:localDefine><ml:id>y</ml:id><ml:onError><ml:apply><ml:div/><ml:real>1</ml:real><ml:id>x</ml:id></ml:apply><ml:real>0</ml:real></ml:onError></ml:localDefine><ml:id>y</ml:id></ml:program></ml:define></math></region>
<region region-id="8" left="36" top="340" width="300" height="60"><math><ml:eval><ml:apply><ml:id>k</ml:id><ml:real>0</ml:real></ml:apply></ml:eval></math></region>
<region region-id="9" left="36" top="380" width="300" height="60"><math><ml:define><ml:id>bad</ml:id><ml:program><ml:weirdStatement><ml:real>1</ml:real></ml:weirdStatement></ml:program></ml:define></math></region>
</regions>
</worksheet>
