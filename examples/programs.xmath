  {
   "x": 24,
   "y": 52,
   "type": "text",
   "text": "Программы набираются как в Mathcad 15: ] — добавить строку, { — локальное определение ←, } — if, Ctrl+Shift+] — otherwise, Ctrl+Shift+' — for, Ctrl+] — while, Ctrl+Shift+[ — break, Ctrl+[ — continue, Ctrl+Shift+\\ — return, Ctrl+' — on error (или палитра «Программирование»).",
   "width": 520.0,
   "style": {
    "size": 10.0,
    "bold": false,
    "italic": false,
    "underline": false
   },
   "id": 2
  },
  {
   "x": 24,
   "y": 112,
   "type": "text",
   "text": "1. Сумма квадратов (цикл for)",
