   "source": "bisect(f, a, b) := { lo ← a; hi ← b; for k ∈ 1..200 { m ← (lo + hi)/2; return m if abs(hi - lo) < 1e-12; if f(lo)*f(m) <= 0 { hi ← m } otherwise { lo ← m } }; (lo + hi)/2 }",
