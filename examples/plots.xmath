   "source": "x := 0, 0.1 .. 10",
   "id": 3
  },
  {
   "x": 180,
   "y": 84,
   "type": "math",
   "source": "t := 1, 2 .. 100",
   "id": 4
  },
  {
   "x": 24,
   "y": 120,
   "type": "plot",
   "x_expr": "x",
   "y_exprs": [
